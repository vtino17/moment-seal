{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vtino17/moment-seal/schemas/policy.schema.json",
  "title": "MomentSeal consistency policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policyVersion",
    "planId",
    "maximumObservationAgeMs",
    "maximumCheckUseGapMs",
    "maximumCommitStateAgeMs",
    "maximumRevalidationAgeMs",
    "minimumAuthority",
    "requireConditionalForMutations",
    "requireRevalidationForIrreversible",
    "requireScopeBinding",
    "maximumDependencyDepth",
    "maximumActions",
    "maximumObservations",
    "maximumDependencyEdges"
  ],
  "properties": {
    "policyVersion": { "const": "2.0" },
    "planId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "maximumObservationAgeMs": { "type": "integer", "minimum": 0 },
    "maximumCheckUseGapMs": { "type": "integer", "minimum": 0 },
    "maximumCommitStateAgeMs": { "type": "integer", "minimum": 0 },
    "maximumRevalidationAgeMs": { "type": "integer", "minimum": 0 },
    "minimumAuthority": { "type": "integer", "minimum": 0, "maximum": 100 },
    "requireConditionalForMutations": { "type": "boolean" },
    "requireRevalidationForIrreversible": { "type": "boolean" },
    "requireScopeBinding": { "type": "boolean" },
    "maximumDependencyDepth": { "type": "integer", "minimum": 0 },
    "maximumActions": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "maximumObservations": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "maximumDependencyEdges": { "type": "integer", "minimum": 0, "maximum": 10000 }
  }
}
