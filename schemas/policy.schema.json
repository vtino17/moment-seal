{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vtino17/moment-seal/schemas/policy.schema.json",
  "title": "MomentSeal consistency policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policyVersion",
    "planId",
    "maximumObservationAgeMs",
    "maximumCheckUseGapMs",
    "maximumRevalidationAgeMs",
    "minimumAuthority",
    "requireConditionalForMutations",
    "requireRevalidationForIrreversible",
    "maximumDependencyDepth"
  ],
  "properties": {
    "policyVersion": { "const": "1.0" },
    "planId": { "type": "string", "minLength": 1 },
    "maximumObservationAgeMs": { "type": "number", "minimum": 0 },
    "maximumCheckUseGapMs": { "type": "number", "minimum": 0 },
    "maximumRevalidationAgeMs": { "type": "number", "minimum": 0 },
    "minimumAuthority": { "type": "number", "minimum": 0, "maximum": 100 },
    "requireConditionalForMutations": { "type": "boolean" },
    "requireRevalidationForIrreversible": { "type": "boolean" },
    "maximumDependencyDepth": { "type": "number", "minimum": 0 }
  }
}
