{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vtino17/moment-seal/schemas/receipt.schema.json",
  "title": "MomentSeal receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receiptVersion", "planId", "planHash", "policyHash", "compilationHash", "compiledAt", "issuedAt", "committedActionIds", "receiptHash"],
  "properties": {
    "receiptVersion": { "const": "2.0" },
    "planId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "planHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "policyHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "compilationHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "compiledAt": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "issuedAt": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "committedActionIds": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "receiptHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
